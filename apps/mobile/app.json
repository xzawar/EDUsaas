{
  "expo": {
    "name": "EDUsaas",
    "slug": "edusaas",
    "version": "1.0.0",
    "scheme": "edusaas",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f4f8"
    },
    "android": {
      "package": "com.edusaas.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#6d5dfc",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA", "POST_NOTIFICATIONS", "USE_BIOMETRIC", "USE_FINGERPRINT", "VIBRATE"],
      "usesCleartextTraffic": false,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "edusaas"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.edusaas.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-image",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#6d5dfc",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock EDUsaas"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take a photo of your payment proof or a bill."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
