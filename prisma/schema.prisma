// EDUsaas database schema.
// Every tenant-owned table has `tenant_id` and an RLS policy (see migrations/*_rls). `npm run db:check-rls` enforces this.
// Phase 1 scope: Tenancy, Identity, Audit. Later phases add their tables in their own migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum UserRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  ADMISSIONS_OFFICER
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Portal {
  STUDENT
  STAFF
  PLATFORM
}

enum AttendanceMode {
  ONCE_DAILY
  PER_PERIOD
}

enum MarksPublisher {
  SCHOOL_ADMIN
  PRINCIPAL
}

// ───────────── Tenancy ─────────────

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  /// Username prefix, unique platform-wide, lowercase letters/digits only (e.g. "bss").
  prefix      String       @unique
  status      TenantStatus @default(TRIAL)
  city        String?
  suspendedAt DateTime?    @map("suspended_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  settings        TenantSettings?
  rolePermissions TenantRolePermission[]
  users           User[]

  @@map("tenants")
}

model TenantSettings {
  tenantId          String         @id @map("tenant_id") @db.Uuid
  timezone          String         @default("Asia/Karachi")
  attendanceMode    AttendanceMode @default(ONCE_DAILY) @map("attendance_mode")
  atRiskThreshold   Int            @default(75) @map("at_risk_threshold")
  marksPublisher    MarksPublisher @default(SCHOOL_ADMIN) @map("marks_publisher")
  leaveAgeOutHours  Int            @default(48) @map("leave_age_out_hours")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// Per-school toggles for configurable roles (Principal, Admissions Officer). Missing row = role default.
model TenantRolePermission {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  role       UserRole
  permission String
  granted    Boolean
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, permission])
  @@map("tenant_role_permissions")
}

// ───────────── Identity ─────────────

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  /// NULL only for platform users (enforced by CHECK constraint).
  tenantId            String?    @map("tenant_id") @db.Uuid
  role                UserRole
  displayName         String     @map("display_name")
  /// Canonical/display username, e.g. "bss-9a-ahmad-14". NULL for email-only accounts.
  username            String?
  /// Lowercase, separators stripped: "bss9aahmad14". Login lookups use this.
  usernameNormalized  String?    @unique @map("username_normalized")
  /// Lowercased email. Required for School Admin / Principal / Admissions Officer / platform roles.
  email               String?    @unique
  passwordHash        String     @map("password_hash")
  mustChangePassword  Boolean    @default(true) @map("must_change_password")
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  lastLoginAt         DateTime?  @map("last_login_at")
  passwordChangedAt   DateTime?  @map("password_changed_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  tenant         Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions       Session[]
  passwordResets PasswordResetToken[]

  @@index([tenantId, role])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  /// SHA-256 of the opaque cookie token. The raw token is never stored.
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  portal     Portal
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  ipHash     String?  @map("ip_hash")
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ───────────── Ops & security ─────────────

/// Insert-only for every runtime DB role. No FKs on purpose: audit rows must never cascade or change.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String?  @map("tenant_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorRole      UserRole? @map("actor_role")
  action         String
  entity         String
  entityId       String?  @map("entity_id")
  outcome        String   @default("success")
  before         Json?
  after          Json?
  metadata       Json?
  ipHash         String?  @map("ip_hash")
  userAgent      String?  @map("user_agent")
  requestId      String?  @map("request_id")
  supportGrantId String?  @map("support_grant_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
