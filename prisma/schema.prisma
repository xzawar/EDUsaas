// EDUsaas database schema.
// Every tenant-owned table has `tenant_id` and an RLS policy (see migrations/*_rls). `npm run db:check-rls` enforces this.
// Phase 1 scope: Tenancy, Identity, Audit. Later phases add their tables in their own migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum UserRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  ADMISSIONS_OFFICER
  ACCOUNTANT
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Portal {
  STUDENT
  STAFF
  PLATFORM
}

enum AttendanceMode {
  ONCE_DAILY
  PER_PERIOD
}

enum MarksPublisher {
  SCHOOL_ADMIN
  PRINCIPAL
}

enum AcademicYearStatus {
  PLANNED
  CURRENT
  CLOSED
}

enum StudentStatus {
  ACTIVE
  WITHDRAWN
  GRADUATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  EXCUSED
}

enum TeacherAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
}

enum RemarkStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnnouncementAudience {
  EVERYONE
  STAFF
  STUDENTS
  SECTION
}

enum SupportGrantStatus {
  AWAITING_OWNER
  PENDING
  ACTIVE
  DENIED
  REVOKED
  EXPIRED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// ───────────── Tenancy ─────────────

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  /// Username prefix, unique platform-wide, lowercase letters/digits only (e.g. "bss").
  prefix      String       @unique
  status      TenantStatus @default(TRIAL)
  city        String?
  suspendedAt DateTime?    @map("suspended_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  settings           TenantSettings?
  rolePermissions    TenantRolePermission[]
  users              User[]
  academicYears      AcademicYear[]
  classes            Class[]
  sections           Section[]
  subjects           Subject[]
  classSubjects      ClassSubject[]
  teachers           Teacher[]
  teacherAssignments TeacherAssignment[]
  students           Student[]
  gradingSchemes     GradingScheme[]
  jobs               Job[]
  attendanceBatches  AttendanceBatch[]
  attendanceRecords  AttendanceRecord[]
  teacherAttendance  TeacherAttendance[]
  leaveTypes         LeaveType[]
  leaveRequests      LeaveRequest[]
  assessments        Assessment[]
  marks              Mark[]
  remarks            Remark[]
  timetableSlots     TimetableSlot[]
  timetableEntries   TimetableEntry[]
  notifications      Notification[]
  announcements      Announcement[]
  supportGrants      SupportGrant[]
  subscription       Subscription?
  supportTickets     SupportTicket[]
  ticketMessages     TicketMessage[]
  studentArchives    StudentArchive[]
  feeHeads           FeeHead[]
  feeStructures      FeeStructure[]
  feeOverrides       StudentFeeOverride[]
  feeDiscounts       FeeDiscount[]
  lateFeeRules       LateFeeRule[]
  invoices           Invoice[]
  invoiceLines       InvoiceLine[]
  payments           Payment[]
  paymentAllocations PaymentAllocation[]
  paymentClaims      PaymentClaim[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  salaryStructures   SalaryStructure[]
  payrollRuns        PayrollRun[]
  payslips           Payslip[]
  ledgerEntries      LedgerEntry[]
  financeSequences   FinanceSequence[]

  @@map("tenants")
}

model TenantSettings {
  tenantId         String         @id @map("tenant_id") @db.Uuid
  timezone         String         @default("Asia/Karachi")
  attendanceMode   AttendanceMode @default(ONCE_DAILY) @map("attendance_mode")
  atRiskThreshold  Int            @default(75) @map("at_risk_threshold")
  marksPublisher   MarksPublisher @default(SCHOOL_ADMIN) @map("marks_publisher")
  leaveAgeOutHours Int            @default(48) @map("leave_age_out_hours")
  /// Finance: day of month invoices are generated, days until due, term start months, receipt footer.
  invoiceDay       Int            @default(1) @map("invoice_day")
  feeDueDays       Int            @default(10) @map("fee_due_days")
  termStartMonths  Int[]          @default([4, 9, 1]) @map("term_start_months")
  receiptFooter    String?        @map("receipt_footer")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// Per-school toggles for configurable roles (Principal, Admissions Officer). Missing row = role default.
model TenantRolePermission {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  role       UserRole
  permission String
  granted    Boolean
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, permission])
  @@map("tenant_role_permissions")
}

// ───────────── Identity ─────────────

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  /// NULL only for platform users (enforced by CHECK constraint).
  tenantId            String?    @map("tenant_id") @db.Uuid
  role                UserRole
  displayName         String     @map("display_name")
  /// Canonical/display username, e.g. "bss-9a-ahmad-14". NULL for email-only accounts.
  username            String?
  /// Lowercase, separators stripped: "bss9aahmad14". Login lookups use this.
  usernameNormalized  String?    @unique @map("username_normalized")
  /// Lowercased email. Required for School Admin / Principal / Admissions Officer / platform roles.
  email               String?    @unique
  passwordHash        String     @map("password_hash")
  mustChangePassword  Boolean    @default(true) @map("must_change_password")
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  lastLoginAt         DateTime?  @map("last_login_at")
  passwordChangedAt   DateTime?  @map("password_changed_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  tenant           Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions         Session[]
  passwordResets   PasswordResetToken[]
  teacher          Teacher?
  student          Student?
  leaveRequests    LeaveRequest[]            @relation("LeaveApplicant")
  remarks          Remark[]                  @relation("RemarkAuthor")
  notifications    Notification[]
  announcements    Announcement[]
  platformGrants   PlatformPermissionGrant[]
  ticketsCreated   SupportTicket[]           @relation("TicketAuthor")
  salaryStructures SalaryStructure[]
  payslips         Payslip[]
  pushTokens       PushToken[]

  @@index([tenantId, role])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  /// SHA-256 of the opaque cookie token. The raw token is never stored.
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  portal     Portal
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  ipHash     String?  @map("ip_hash")
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ───────────── Ops & security ─────────────

/// Insert-only for every runtime DB role. No FKs on purpose: audit rows must never cascade or change.
model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  actorId        String?   @map("actor_id") @db.Uuid
  actorRole      UserRole? @map("actor_role")
  action         String
  entity         String
  entityId       String?   @map("entity_id")
  outcome        String    @default("success")
  before         Json?
  after          Json?
  metadata       Json?
  ipHash         String?   @map("ip_hash")
  userAgent      String?   @map("user_agent")
  requestId      String?   @map("request_id")
  supportGrantId String?   @map("support_grant_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ───────────── Structure (Phase 2) ─────────────
// Hierarchy (spec §1.1): Tenant → Academic Year → Class → Section. Cross-tenant references are rejected by
// enforce_same_tenant() triggers (FK checks bypass RLS, so the database checks tenant equality itself).

model AcademicYear {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  name      String
  startsOn  DateTime           @map("starts_on") @db.Date
  endsOn    DateTime           @map("ends_on") @db.Date
  status    AcademicYearStatus @default(PLANNED)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes        Class[]
  gradingSchemes GradingScheme[]
  assessments    Assessment[]
  feeStructures  FeeStructure[]
  lateFeeRules   LateFeeRule[]
  invoices       Invoice[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("academic_years")
}

model Class {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String
  /// Ordering key: -2 Playgroup, -1 Nursery, 0 Prep/KG, 1..12 grades.
  gradeLevel     Int      @map("grade_level")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sections      Section[]
  subjects      ClassSubject[]
  feeStructures FeeStructure[]

  @@unique([academicYearId, name])
  @@index([tenantId])
  @@map("classes")
}

model Section {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  name           String
  capacity       Int?
  /// Class Incharge (spec §2.5): a designation, not a role.
  classTeacherId String?  @map("class_teacher_id") @db.Uuid
  /// Next roll number to hand out. Sequential, never gap-filled (spec §3.3).
  nextRollNumber Int      @default(1) @map("next_roll_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class         Class               @relation(fields: [classId], references: [id], onDelete: Restrict)
  classTeacher  Teacher?            @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  students      Student[]
  assignments   TeacherAssignment[]
  attendance    AttendanceBatch[]
  assessments   Assessment[]
  timetable     TimetableEntry[]
  announcements Announcement[]

  @@unique([classId, name])
  @@index([tenantId])
  @@index([classTeacherId])
  @@map("sections")
}

model Subject {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  code       String?
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes     ClassSubject[]
  assignments TeacherAssignment[]
  assessments Assessment[]
  timetable   TimetableEntry[]

  @@unique([tenantId, name])
  @@map("subjects")
}

model ClassSubject {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  classId   String @map("class_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@index([tenantId])
  @@map("class_subjects")
}

// ───────────── People (Phase 2) ─────────────

model Teacher {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  employeeNo    String?   @map("employee_no")
  phone         String?
  qualification String?
  joinedOn      DateTime? @map("joined_on") @db.Date
  photoKey      String?   @map("photo_key")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]
  inchargeOf  Section[]           @relation("ClassTeacher")
  attendance  TeacherAttendance[]
  timetable   TimetableEntry[]

  @@unique([tenantId, employeeNo])
  @@index([tenantId])
  @@map("teachers")
}

/// Teacher + section + subject (spec §5.2). Powers every teacher scope check.
model TeacherAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([teacherId, sectionId, subjectId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([tenantId])
  @@map("teacher_assignments")
}

model Student {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  userId        String        @unique @map("user_id") @db.Uuid
  /// Current placement (spec §8 "Placement").
  sectionId     String?       @map("section_id") @db.Uuid
  /// Sticky; never renumbered automatically (spec §3.3).
  rollNumber    Int?          @map("roll_number")
  admissionNo   String?       @map("admission_no")
  gender        Gender?
  dateOfBirth   DateTime?     @map("date_of_birth") @db.Date
  guardianName  String?       @map("guardian_name")
  guardianPhone String?       @map("guardian_phone")
  address       String?
  photoKey      String?       @map("photo_key")
  status        StudentStatus @default(ACTIVE)
  admittedOn    DateTime      @default(now()) @map("admitted_on") @db.Date
  withdrawnAt   DateTime?     @map("withdrawn_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  section       Section?             @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  attendance    AttendanceRecord[]
  marks         Mark[]
  remarks       Remark[]
  leaves        LeaveRequest[]
  feeOverrides  StudentFeeOverride[]
  feeDiscounts  FeeDiscount[]
  invoices      Invoice[]
  payments      Payment[]
  paymentClaims PaymentClaim[]
  ledgerEntries LedgerEntry[]

  @@unique([sectionId, rollNumber])
  @@unique([tenantId, admissionNo])
  @@index([tenantId, status])
  @@index([tenantId, guardianPhone])
  @@map("students")
}

// ───────────── Assessment config (Phase 2: defaults; Phase 3 uses them) ─────────────

/// Versioned per academic year (spec §7.2). Bands: [{ grade, min }] in percent, highest first.
model GradingScheme {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  version        Int      @default(1)
  bands          Json
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  assessments  Assessment[]

  @@unique([academicYearId, version])
  @@index([tenantId])
  @@map("grading_schemes")
}

// ───────────── Jobs (decision D4) ─────────────

model Job {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String?   @map("tenant_id") @db.Uuid
  type       String
  status     JobStatus @default(QUEUED)
  payload    Json
  progress   Json?
  result     Json?
  error      String?
  attempts   Int       @default(0)
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("jobs")
}

// ───────────── Attendance (Phase 3, spec §6) ─────────────
// A row per student per sheet; percentages are computed at read time, never stored.

/**
 * One submitted register for a section on a date (period 1 = once-daily mode). Idempotent by client_uuid.
 */
model AttendanceBatch {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  sectionId        String    @map("section_id") @db.Uuid
  date             DateTime  @db.Date
  period           Int       @default(1)
  subjectId        String?   @map("subject_id") @db.Uuid
  submittedBy      String    @map("submitted_by") @db.Uuid
  clientUuid       String    @map("client_uuid")
  clientRecordedAt DateTime? @map("client_recorded_at")
  serverReceivedAt DateTime  @default(now()) @map("server_received_at")
  syncedLate       Boolean   @default(false) @map("synced_late")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by") @db.Uuid

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@unique([tenantId, sectionId, date, period])
  @@unique([tenantId, clientUuid])
  @@index([tenantId, date])
  @@map("attendance_batches")
}

model AttendanceRecord {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  batchId   String           @map("batch_id") @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  status    AttendanceStatus

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch   AttendanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@index([studentId])
  @@index([tenantId])
  @@map("attendance_records")
}

/**
 * Teacher self check-in (spec §6.5). Kept fully separate from student attendance.
 */
model TeacherAttendance {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @map("tenant_id") @db.Uuid
  teacherId   String                  @map("teacher_id") @db.Uuid
  date        DateTime                @db.Date
  status      TeacherAttendanceStatus
  checkedInAt DateTime?               @map("checked_in_at")
  note        String?
  correctedBy String?                 @map("corrected_by") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@index([tenantId, date])
  @@map("teacher_attendance")
}

// ───────────── Leave (Phase 3, decision D5) ─────────────

model LeaveType {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  forStudents Boolean   @default(true) @map("for_students")
  forStaff    Boolean   @default(true) @map("for_staff")
  /// Unpaid leave types reduce staff salary in payroll (Finance).
  paid        Boolean   @default(true)
  archivedAt  DateTime? @map("archived_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests LeaveRequest[]

  @@unique([tenantId, name])
  @@map("leave_types")
}

model LeaveRequest {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  applicantId  String      @map("applicant_id") @db.Uuid
  /// Set when the applicant is a student (routes to their Class Incharge).
  studentId    String?     @map("student_id") @db.Uuid
  typeId       String      @map("type_id") @db.Uuid
  fromDate     DateTime    @map("from_date") @db.Date
  toDate       DateTime    @map("to_date") @db.Date
  reason       String
  status       LeaveStatus @default(PENDING)
  decidedBy    String?     @map("decided_by") @db.Uuid
  decidedAt    DateTime?   @map("decided_at")
  decisionNote String?     @map("decision_note")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicant User      @relation("LeaveApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  student   Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      LeaveType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([applicantId])
  @@index([studentId])
  @@map("leave_requests")
}

// ───────────── Assessment (Phase 3, spec §7) ─────────────

model Assessment {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  academicYearId  String           @map("academic_year_id") @db.Uuid
  sectionId       String           @map("section_id") @db.Uuid
  subjectId       String           @map("subject_id") @db.Uuid
  gradingSchemeId String           @map("grading_scheme_id") @db.Uuid
  name            String
  maxMarks        Decimal          @map("max_marks") @db.Decimal(6, 2)
  heldOn          DateTime         @map("held_on") @db.Date
  status          AssessmentStatus @default(DRAFT)
  createdBy       String           @map("created_by") @db.Uuid
  submittedBy     String?          @map("submitted_by") @db.Uuid
  submittedAt     DateTime?        @map("submitted_at")
  publishedBy     String?          @map("published_by") @db.Uuid
  publishedAt     DateTime?        @map("published_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  section       Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject       Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradingScheme GradingScheme @relation(fields: [gradingSchemeId], references: [id], onDelete: Restrict)
  marks         Mark[]

  @@index([tenantId, sectionId])
  @@index([sectionId, subjectId])
  @@index([academicYearId])
  @@index([subjectId])
  @@index([gradingSchemeId])
  @@map("assessments")
}

model Mark {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  score        Decimal? @db.Decimal(6, 2)
  absent       Boolean  @default(false)
  updatedBy    String?  @map("updated_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([tenantId])
  @@map("marks")
}

/**
 * Teacher remarks; visible to students only once approved by the Class Incharge or School Admin (spec §7.4).
 */
model Remark {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  studentId   String       @map("student_id") @db.Uuid
  authorId    String       @map("author_id") @db.Uuid
  subjectName String?      @map("subject_name")
  text        String
  status      RemarkStatus @default(PENDING)
  moderatedBy String?      @map("moderated_by") @db.Uuid
  moderatedAt DateTime?    @map("moderated_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation("RemarkAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([studentId])
  @@index([authorId])
  @@map("remarks")
}

// ───────────── Timetable (Phase 3, decision D12) ─────────────
// Stored per section, never per student (spec §12.2). DB constraints make clashes impossible.

model TimetableSlot {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  /// 1 = Monday … 7 = Sunday
  dayOfWeek Int     @map("day_of_week")
  periodNo  Int     @map("period_no")
  startsAt  String  @map("starts_at")
  endsAt    String  @map("ends_at")
  isBreak   Boolean @default(false) @map("is_break")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries TimetableEntry[]

  @@unique([tenantId, dayOfWeek, periodNo])
  @@map("timetable_slots")
}

model TimetableEntry {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  sectionId String  @map("section_id") @db.Uuid
  slotId    String  @map("slot_id") @db.Uuid
  subjectId String  @map("subject_id") @db.Uuid
  teacherId String? @map("teacher_id") @db.Uuid
  room      String?

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slot    TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  subject Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([sectionId, slotId])
  @@index([teacherId])
  @@index([slotId])
  @@index([subjectId])
  @@index([tenantId])
  @@map("timetable_entries")
}

// ───────────── In-app notifications (spec §1.3; channels beyond in-app deferred) ─────────────

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  title     String
  body      String
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

// ───────────── Announcements (Phase 4, spec §8.11) ─────────────

model Announcement {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  title     String
  body      String
  audience  AnnouncementAudience
  sectionId String?              @map("section_id") @db.Uuid
  pinned    Boolean              @default(false)
  createdBy String               @map("created_by") @db.Uuid
  createdAt DateTime             @default(now()) @map("created_at")
  expiresOn DateTime?            @map("expires_on") @db.Date
  deletedAt DateTime?            @map("deleted_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  author  User     @relation(fields: [createdBy], references: [id])

  @@index([tenantId, createdAt])
  @@map("announcements")
}

// ───────────── Break-glass support access (Phase 5, spec §2.7, §9.6) ─────────────
// The Platform Owner never has silent access to school data: they request a time-boxed, read-only grant with a
// reason; the School Admin approves or denies it; every use is written to the school's own audit log.

model SupportGrant {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  requestedBy     String             @map("requested_by") @db.Uuid
  requesterName   String             @map("requester_name")
  reason          String
  durationMinutes Int                @map("duration_minutes")
  status          SupportGrantStatus @default(PENDING)
  /// Set when a Platform Admin asked and the Platform Owner approved (spec §9.6).
  ownerApprovedBy String?            @map("owner_approved_by") @db.Uuid
  ticketId        String?            @map("ticket_id") @db.Uuid
  decidedBy       String?            @map("decided_by") @db.Uuid
  decidedAt       DateTime?          @map("decided_at")
  expiresAt       DateTime?          @map("expires_at")
  endedAt         DateTime?          @map("ended_at")
  createdAt       DateTime           @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([status, expiresAt])
  @@map("support_grants")
}

// Fixed-window counters for per-IP rate limits (login, password reset). Written by the system role only.
model RateLimit {
  key         String   @id
  windowStart DateTime @map("window_start")
  count       Int

  @@map("rate_limits")
}

// ───────────── SaaS: plans & subscriptions (Phase 6, spec §2.7, §8 "SaaS") ─────────────
// Platform-level tables (no tenant RLS for the app role; only the system role touches them). Usage is counted live
// from the tenant's own tables rather than kept in a counter table, so it can never drift.

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique
  priceMonthly Int      @default(0) @map("price_monthly")
  maxStudents  Int?     @map("max_students")
  maxStaff     Int?     @map("max_staff")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @unique @map("tenant_id") @db.Uuid
  planId    String             @map("plan_id") @db.Uuid
  status    SubscriptionStatus @default(TRIAL)
  startedOn DateTime           @default(now()) @map("started_on") @db.Date
  renewsOn  DateTime?          @map("renews_on") @db.Date
  notes     String?
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("subscriptions")
}

/// Extra permissions the Platform Owner grants to a Platform Admin (spec §2.7, §2.8).
model PlatformPermissionGrant {
  userId     String   @map("user_id") @db.Uuid
  permission String
  grantedBy  String   @map("granted_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permission])
  @@map("platform_permission_grants")
}

// ───────────── Support tickets (spec §2.8 "support ticket queue", §9.6 step 1) ─────────────

model SupportTicket {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  createdBy String       @map("created_by") @db.Uuid
  subject   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author   User            @relation("TicketAuthor", fields: [createdBy], references: [id])
  messages TicketMessage[]

  @@index([tenantId, createdAt])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model TicketMessage {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  authorName   String   @map("author_name")
  fromPlatform Boolean  @default(false) @map("from_platform")
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ───────────── Archival (spec §10) ─────────────

/// A closed year's report card kept in object storage after promotion (spec §5.4, §10.2).
model StudentArchive {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  yearName       String   @map("year_name")
  storageKey     String   @map("storage_key")
  bytes          Int
  createdAt      DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([tenantId])
  @@map("student_archives")
}

/// One file per school per month of audit logs moved to object storage (spec §10.3).
model AuditArchive {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  month      String
  storageKey String   @map("storage_key")
  rows       Int
  sha256     String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([tenantId, month])
  @@map("audit_archives")
}

// ───────────── Finance (spec docs/superpowers/specs/2026-11-11-finance-and-android-design.md §2) ─────────────
// Money is BIGINT paisa (1 PKR = 100 paisa). Payments, expenses and ledger entries are never deleted; corrections
// are reversals. Numbers (receipt, invoice, voucher, payslip) are gap-free per school via finance_sequences.

enum FeeKind {
  MONTHLY
  TERM
  ONCE
}

enum DiscountKind {
  PERCENT
  FIXED
}

enum LateFeeKind {
  FIXED
  PERCENT
  PER_DAY
}

enum InvoiceStatus {
  DUE
  PARTIAL
  PAID
  WAIVED
  VOID
}

enum PaymentMethod {
  CASH
  BANK
  JAZZCASH
  EASYPAISA
  CHEQUE
}

enum ClaimStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  FINALISED
  PAID
}

enum LedgerKind {
  FEE
  ADVANCE
  EXPENSE
  SALARY
  REVERSAL
}

enum LedgerDirection {
  IN
  OUT
}

enum SequenceKind {
  RECEIPT
  INVOICE
  VOUCHER
  PAYSLIP
}

enum PerDayDeduction {
  BASIC_30
  NONE
}

model FeeHead {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  kind       FeeKind   @default(MONTHLY)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  structures FeeStructure[]
  overrides  StudentFeeOverride[]
  discounts  FeeDiscount[]
  lines      InvoiceLine[]

  @@unique([tenantId, name])
  @@map("fee_heads")
}

model FeeStructure {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  feeHeadId      String   @map("fee_head_id") @db.Uuid
  amountPaisa    BigInt   @map("amount_paisa")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  feeHead      FeeHead      @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@unique([academicYearId, classId, feeHeadId])
  @@index([tenantId])
  @@map("fee_structures")
}

model StudentFeeOverride {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  feeHeadId   String   @map("fee_head_id") @db.Uuid
  amountPaisa BigInt   @map("amount_paisa")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeHead FeeHead @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@unique([studentId, feeHeadId])
  @@index([tenantId])
  @@map("student_fee_overrides")
}

model FeeDiscount {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  studentId String       @map("student_id") @db.Uuid
  /// NULL = applies to every fee head.
  feeHeadId String?      @map("fee_head_id") @db.Uuid
  kind      DiscountKind
  /// PERCENT: hundredths of a percent (1250 = 12.50%). FIXED: paisa.
  value     Int
  reason    String
  validFrom DateTime     @map("valid_from") @db.Date
  validTo   DateTime?    @map("valid_to") @db.Date
  createdBy String       @map("created_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeHead FeeHead? @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@index([tenantId, studentId])
  @@map("fee_discounts")
}

model LateFeeRule {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  academicYearId String      @unique @map("academic_year_id") @db.Uuid
  graceDays      Int         @default(0) @map("grace_days")
  kind           LateFeeKind @default(FIXED)
  /// FIXED/PER_DAY: paisa. PERCENT: hundredths of a percent.
  value          Int         @default(0)
  capPaisa       BigInt?     @map("cap_paisa")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("late_fee_rules")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  academicYearId String        @map("academic_year_id") @db.Uuid
  /// "YYYY-MM" (monthly), "YYYY-T1|T2|T3" (term), "YYYY-ONCE-<feeHeadId>" (one-time).
  period         String
  number         String
  issuedOn       DateTime      @map("issued_on") @db.Date
  dueOn          DateTime      @map("due_on") @db.Date
  subtotalPaisa  BigInt        @map("subtotal_paisa")
  discountPaisa  BigInt        @default(0) @map("discount_paisa")
  /// Live until the invoice is fully paid, then frozen here. NULL = compute from the rule.
  lateFeePaisa   BigInt?       @map("late_fee_paisa")
  lateFeeWaived  Boolean       @default(false) @map("late_fee_waived")
  paidPaisa      BigInt        @default(0) @map("paid_paisa")
  status         InvoiceStatus @default(DUE)
  /// User id, or NULL when generated by the monthly job.
  generatedBy    String?       @map("generated_by") @db.Uuid
  voidReason     String?       @map("void_reason")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  lines        InvoiceLine[]
  payments     Payment[]
  claims       PaymentClaim[]
  allocations  PaymentAllocation[]

  @@unique([tenantId, number])
  // One live bill per student per month: a partial unique index (status <> 'VOID', see migration
  // 20261114094908_reissue_void_invoices) so a cancelled bill can be reissued. Prisma cannot model partial uniques.
  @@index([studentId, period])
  @@index([tenantId, status, dueOn])
  @@index([tenantId, period])
  @@map("invoices")
}

model InvoiceLine {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  invoiceId     String @map("invoice_id") @db.Uuid
  feeHeadId     String @map("fee_head_id") @db.Uuid
  description   String
  amountPaisa   BigInt @map("amount_paisa")
  discountPaisa BigInt @default(0) @map("discount_paisa")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHead FeeHead @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  studentId           String        @map("student_id") @db.Uuid
  /// NULL = advance (on account).
  invoiceId           String?       @map("invoice_id") @db.Uuid
  /// Negative only for a reversal row.
  amountPaisa         BigInt        @map("amount_paisa")
  method              PaymentMethod
  reference           String?
  receivedOn          DateTime      @map("received_on") @db.Date
  receivedBy          String        @map("received_by") @db.Uuid
  receiptNumber       String        @map("receipt_number")
  proofKey            String?       @map("proof_key")
  note                String?
  clientKey           String?       @map("client_key") @db.Uuid
  /// Set on the original when it has been reversed.
  reversedByPaymentId String?       @unique @map("reversed_by_payment_id") @db.Uuid
  /// Set on the reversal row: the payment it undoes.
  reversesPaymentId   String?       @unique @map("reverses_payment_id") @db.Uuid
  reversalReason      String?       @map("reversal_reason")
  createdAt           DateTime      @default(now()) @map("created_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice     Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  reverses    Payment?            @relation("PaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: Restrict)
  reversedBy  Payment?            @relation("PaymentReversal")
  claims      PaymentClaim[]
  allocations PaymentAllocation[]

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, clientKey])
  @@index([tenantId, receivedOn])
  @@index([studentId])
  @@map("payments")
}

/// How a payment's money is spread over invoices. A payment's unallocated remainder is the student's advance.
model PaymentAllocation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  amountPaisa BigInt   @map("amount_paisa")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([paymentId])
  @@map("payment_allocations")
}

model PaymentClaim {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  studentId    String        @map("student_id") @db.Uuid
  invoiceId    String        @map("invoice_id") @db.Uuid
  amountPaisa  BigInt        @map("amount_paisa")
  method       PaymentMethod
  reference    String
  paidOn       DateTime      @map("paid_on") @db.Date
  proofKey     String?       @map("proof_key")
  status       ClaimStatus   @default(PENDING)
  decidedBy    String?       @map("decided_by") @db.Uuid
  decidedAt    DateTime?     @map("decided_at")
  decisionNote String?       @map("decision_note")
  paymentId    String?       @map("payment_id") @db.Uuid
  clientKey    String?       @map("client_key") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, clientKey])
  @@index([tenantId, status, createdAt])
  @@map("payment_claims")
}

model ExpenseCategory {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  /// System categories (e.g. Salaries) are created by the app and cannot be archived.
  system     Boolean   @default(false)
  archivedAt DateTime? @map("archived_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([tenantId, name])
  @@map("expense_categories")
}

model Expense {
  id                  String        @id @default(uuid()) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  categoryId          String        @map("category_id") @db.Uuid
  amountPaisa         BigInt        @map("amount_paisa")
  spentOn             DateTime      @map("spent_on") @db.Date
  paidTo              String        @map("paid_to")
  method              PaymentMethod
  voucherNumber       String        @map("voucher_number")
  reference           String?
  receiptKey          String?       @map("receipt_key")
  note                String?
  enteredBy           String        @map("entered_by") @db.Uuid
  clientKey           String?       @map("client_key") @db.Uuid
  reversedByExpenseId String?       @unique @map("reversed_by_expense_id") @db.Uuid
  reversesExpenseId   String?       @unique @map("reverses_expense_id") @db.Uuid
  reversalReason      String?       @map("reversal_reason")
  createdAt           DateTime      @default(now()) @map("created_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reverses   Expense?        @relation("ExpenseReversal", fields: [reversesExpenseId], references: [id], onDelete: Restrict)
  reversedBy Expense?        @relation("ExpenseReversal")

  @@unique([tenantId, voucherNumber])
  @@unique([tenantId, clientKey])
  @@index([tenantId, spentOn])
  @@map("expenses")
}

model SalaryStructure {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  basicPaisa      BigInt          @map("basic_paisa")
  /// [{ name, amountPaisa }]
  allowances      Json            @default("[]")
  deductions      Json            @default("[]")
  effectiveFrom   DateTime        @map("effective_from") @db.Date
  perDayDeduction PerDayDeduction @default(BASIC_30) @map("per_day_deduction")
  updatedBy       String?         @map("updated_by") @db.Uuid
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([tenantId])
  @@map("salary_structures")
}

model PayrollRun {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  /// "YYYY-MM"
  period      String
  status      PayrollStatus @default(DRAFT)
  totalPaisa  BigInt        @default(0) @map("total_paisa")
  runBy       String        @map("run_by") @db.Uuid
  finalisedAt DateTime?     @map("finalised_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@unique([tenantId, period])
  @@map("payroll_runs")
}

model Payslip {
  id                  String         @id @default(uuid()) @db.Uuid
  tenantId            String         @map("tenant_id") @db.Uuid
  payrollRunId        String         @map("payroll_run_id") @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  number              String
  basicPaisa          BigInt         @map("basic_paisa")
  allowances          Json           @default("[]")
  deductions          Json           @default("[]")
  allowancesPaisa     BigInt         @default(0) @map("allowances_paisa")
  deductionsPaisa     BigInt         @default(0) @map("deductions_paisa")
  unpaidLeaveDays     Int            @default(0) @map("unpaid_leave_days")
  leaveDeductionPaisa BigInt         @default(0) @map("leave_deduction_paisa")
  netPaisa            BigInt         @map("net_paisa")
  paidOn              DateTime?      @map("paid_on") @db.Date
  method              PaymentMethod?
  reference           String?

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  run    PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, userId])
  @@unique([tenantId, number])
  @@index([tenantId, userId])
  @@map("payslips")
}

/// Append-only. Every rupee in or out. Reports read only this table. Updates and deletes are blocked by a trigger.
model LedgerEntry {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  entryOn     DateTime        @map("entry_on") @db.Date
  kind        LedgerKind
  direction   LedgerDirection
  amountPaisa BigInt          @map("amount_paisa")
  method      PaymentMethod?
  refTable    String          @map("ref_table")
  refId       String          @map("ref_id") @db.Uuid
  studentId   String?         @map("student_id") @db.Uuid
  userId      String?         @map("user_id") @db.Uuid
  createdBy   String?         @map("created_by") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([tenantId, entryOn])
  @@index([tenantId, studentId])
  @@index([tenantId, kind, entryOn])
  @@map("ledger_entries")
}

/// Expo push tokens for the native app, one row per device. System-managed (deny-all for the app role).
model PushToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique
  platform   String   @default("android")
  appVersion String?  @map("app_version")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

/// Gap-free per-school counters; the row is locked (SELECT … FOR UPDATE) inside the writing transaction.
model FinanceSequence {
  tenantId String       @map("tenant_id") @db.Uuid
  kind     SequenceKind
  next     Int          @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, kind])
  @@map("finance_sequences")
}
