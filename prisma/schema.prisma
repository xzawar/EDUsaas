// EDUsaas database schema.
// Every tenant-owned table has `tenant_id` and an RLS policy (see migrations/*_rls). `npm run db:check-rls` enforces this.
// Phase 1 scope: Tenancy, Identity, Audit. Later phases add their tables in their own migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum UserRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  ADMISSIONS_OFFICER
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Portal {
  STUDENT
  STAFF
  PLATFORM
}

enum AttendanceMode {
  ONCE_DAILY
  PER_PERIOD
}

enum MarksPublisher {
  SCHOOL_ADMIN
  PRINCIPAL
}

enum AcademicYearStatus {
  PLANNED
  CURRENT
  CLOSED
}

enum StudentStatus {
  ACTIVE
  WITHDRAWN
  GRADUATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  EXCUSED
}

enum TeacherAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
}

enum RemarkStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnnouncementAudience {
  EVERYONE
  STAFF
  STUDENTS
  SECTION
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

// ───────────── Tenancy ─────────────

model Tenant {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  /// Username prefix, unique platform-wide, lowercase letters/digits only (e.g. "bss").
  prefix      String       @unique
  status      TenantStatus @default(TRIAL)
  city        String?
  suspendedAt DateTime?    @map("suspended_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  settings           TenantSettings?
  rolePermissions    TenantRolePermission[]
  users              User[]
  academicYears      AcademicYear[]
  classes            Class[]
  sections           Section[]
  subjects           Subject[]
  classSubjects      ClassSubject[]
  teachers           Teacher[]
  teacherAssignments TeacherAssignment[]
  students           Student[]
  gradingSchemes     GradingScheme[]
  jobs               Job[]
  attendanceBatches  AttendanceBatch[]
  attendanceRecords  AttendanceRecord[]
  teacherAttendance  TeacherAttendance[]
  leaveTypes         LeaveType[]
  leaveRequests      LeaveRequest[]
  assessments        Assessment[]
  marks              Mark[]
  remarks            Remark[]
  timetableSlots     TimetableSlot[]
  timetableEntries   TimetableEntry[]
  notifications      Notification[]
  announcements      Announcement[]

  @@map("tenants")
}

model TenantSettings {
  tenantId         String         @id @map("tenant_id") @db.Uuid
  timezone         String         @default("Asia/Karachi")
  attendanceMode   AttendanceMode @default(ONCE_DAILY) @map("attendance_mode")
  atRiskThreshold  Int            @default(75) @map("at_risk_threshold")
  marksPublisher   MarksPublisher @default(SCHOOL_ADMIN) @map("marks_publisher")
  leaveAgeOutHours Int            @default(48) @map("leave_age_out_hours")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

/// Per-school toggles for configurable roles (Principal, Admissions Officer). Missing row = role default.
model TenantRolePermission {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  role       UserRole
  permission String
  granted    Boolean
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, role, permission])
  @@map("tenant_role_permissions")
}

// ───────────── Identity ─────────────

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  /// NULL only for platform users (enforced by CHECK constraint).
  tenantId            String?    @map("tenant_id") @db.Uuid
  role                UserRole
  displayName         String     @map("display_name")
  /// Canonical/display username, e.g. "bss-9a-ahmad-14". NULL for email-only accounts.
  username            String?
  /// Lowercase, separators stripped: "bss9aahmad14". Login lookups use this.
  usernameNormalized  String?    @unique @map("username_normalized")
  /// Lowercased email. Required for School Admin / Principal / Admissions Officer / platform roles.
  email               String?    @unique
  passwordHash        String     @map("password_hash")
  mustChangePassword  Boolean    @default(true) @map("must_change_password")
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  lastLoginAt         DateTime?  @map("last_login_at")
  passwordChangedAt   DateTime?  @map("password_changed_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  deletedAt           DateTime?  @map("deleted_at")

  tenant         Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions       Session[]
  passwordResets PasswordResetToken[]
  teacher        Teacher?
  student        Student?
  leaveRequests  LeaveRequest[]       @relation("LeaveApplicant")
  remarks        Remark[]             @relation("RemarkAuthor")
  notifications  Notification[]
  announcements  Announcement[]

  @@index([tenantId, role])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  /// SHA-256 of the opaque cookie token. The raw token is never stored.
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  portal     Portal
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  ipHash     String?  @map("ip_hash")
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ───────────── Ops & security ─────────────

/// Insert-only for every runtime DB role. No FKs on purpose: audit rows must never cascade or change.
model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  actorId        String?   @map("actor_id") @db.Uuid
  actorRole      UserRole? @map("actor_role")
  action         String
  entity         String
  entityId       String?   @map("entity_id")
  outcome        String    @default("success")
  before         Json?
  after          Json?
  metadata       Json?
  ipHash         String?   @map("ip_hash")
  userAgent      String?   @map("user_agent")
  requestId      String?   @map("request_id")
  supportGrantId String?   @map("support_grant_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ───────────── Structure (Phase 2) ─────────────
// Hierarchy (spec §1.1): Tenant → Academic Year → Class → Section. Cross-tenant references are rejected by
// enforce_same_tenant() triggers (FK checks bypass RLS, so the database checks tenant equality itself).

model AcademicYear {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  name      String
  startsOn  DateTime           @map("starts_on") @db.Date
  endsOn    DateTime           @map("ends_on") @db.Date
  status    AcademicYearStatus @default(PLANNED)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes        Class[]
  gradingSchemes GradingScheme[]
  assessments    Assessment[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("academic_years")
}

model Class {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String
  /// Ordering key: -2 Playgroup, -1 Nursery, 0 Prep/KG, 1..12 grades.
  gradeLevel     Int      @map("grade_level")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  sections     Section[]
  subjects     ClassSubject[]

  @@unique([academicYearId, name])
  @@index([tenantId])
  @@map("classes")
}

model Section {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  name           String
  capacity       Int?
  /// Class Incharge (spec §2.5): a designation, not a role.
  classTeacherId String?  @map("class_teacher_id") @db.Uuid
  /// Next roll number to hand out. Sequential, never gap-filled (spec §3.3).
  nextRollNumber Int      @default(1) @map("next_roll_number")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class         Class               @relation(fields: [classId], references: [id], onDelete: Restrict)
  classTeacher  Teacher?            @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  students      Student[]
  assignments   TeacherAssignment[]
  attendance    AttendanceBatch[]
  assessments   Assessment[]
  timetable     TimetableEntry[]
  announcements Announcement[]

  @@unique([classId, name])
  @@index([tenantId])
  @@index([classTeacherId])
  @@map("sections")
}

model Subject {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  code       String?
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes     ClassSubject[]
  assignments TeacherAssignment[]
  assessments Assessment[]
  timetable   TimetableEntry[]

  @@unique([tenantId, name])
  @@map("subjects")
}

model ClassSubject {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  classId   String @map("class_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@index([tenantId])
  @@map("class_subjects")
}

// ───────────── People (Phase 2) ─────────────

model Teacher {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  employeeNo    String?   @map("employee_no")
  phone         String?
  qualification String?
  joinedOn      DateTime? @map("joined_on") @db.Date
  photoKey      String?   @map("photo_key")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]
  inchargeOf  Section[]           @relation("ClassTeacher")
  attendance  TeacherAttendance[]
  timetable   TimetableEntry[]

  @@unique([tenantId, employeeNo])
  @@index([tenantId])
  @@map("teachers")
}

/// Teacher + section + subject (spec §5.2). Powers every teacher scope check.
model TeacherAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  sectionId String   @map("section_id") @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([teacherId, sectionId, subjectId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([tenantId])
  @@map("teacher_assignments")
}

model Student {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  userId        String        @unique @map("user_id") @db.Uuid
  /// Current placement (spec §8 "Placement").
  sectionId     String?       @map("section_id") @db.Uuid
  /// Sticky; never renumbered automatically (spec §3.3).
  rollNumber    Int?          @map("roll_number")
  admissionNo   String?       @map("admission_no")
  gender        Gender?
  dateOfBirth   DateTime?     @map("date_of_birth") @db.Date
  guardianName  String?       @map("guardian_name")
  guardianPhone String?       @map("guardian_phone")
  address       String?
  photoKey      String?       @map("photo_key")
  status        StudentStatus @default(ACTIVE)
  admittedOn    DateTime      @default(now()) @map("admitted_on") @db.Date
  withdrawnAt   DateTime?     @map("withdrawn_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  section    Section?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  attendance AttendanceRecord[]
  marks      Mark[]
  remarks    Remark[]
  leaves     LeaveRequest[]

  @@unique([sectionId, rollNumber])
  @@unique([tenantId, admissionNo])
  @@index([tenantId, status])
  @@index([tenantId, guardianPhone])
  @@map("students")
}

// ───────────── Assessment config (Phase 2: defaults; Phase 3 uses them) ─────────────

/// Versioned per academic year (spec §7.2). Bands: [{ grade, min }] in percent, highest first.
model GradingScheme {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  version        Int      @default(1)
  bands          Json
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  assessments  Assessment[]

  @@unique([academicYearId, version])
  @@index([tenantId])
  @@map("grading_schemes")
}

// ───────────── Jobs (decision D4) ─────────────

model Job {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String?   @map("tenant_id") @db.Uuid
  type       String
  status     JobStatus @default(QUEUED)
  payload    Json
  progress   Json?
  result     Json?
  error      String?
  attempts   Int       @default(0)
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([status])
  @@map("jobs")
}

// ───────────── Attendance (Phase 3, spec §6) ─────────────
// A row per student per sheet; percentages are computed at read time, never stored.

/**
 * One submitted register for a section on a date (period 1 = once-daily mode). Idempotent by client_uuid.
 */
model AttendanceBatch {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  sectionId        String    @map("section_id") @db.Uuid
  date             DateTime  @db.Date
  period           Int       @default(1)
  subjectId        String?   @map("subject_id") @db.Uuid
  submittedBy      String    @map("submitted_by") @db.Uuid
  clientUuid       String    @map("client_uuid")
  clientRecordedAt DateTime? @map("client_recorded_at")
  serverReceivedAt DateTime  @default(now()) @map("server_received_at")
  syncedLate       Boolean   @default(false) @map("synced_late")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  updatedBy        String?   @map("updated_by") @db.Uuid

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  records AttendanceRecord[]

  @@unique([tenantId, sectionId, date, period])
  @@unique([tenantId, clientUuid])
  @@index([tenantId, date])
  @@map("attendance_batches")
}

model AttendanceRecord {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  batchId   String           @map("batch_id") @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  status    AttendanceStatus

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch   AttendanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@index([studentId])
  @@index([tenantId])
  @@map("attendance_records")
}

/**
 * Teacher self check-in (spec §6.5). Kept fully separate from student attendance.
 */
model TeacherAttendance {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @map("tenant_id") @db.Uuid
  teacherId   String                  @map("teacher_id") @db.Uuid
  date        DateTime                @db.Date
  status      TeacherAttendanceStatus
  checkedInAt DateTime?               @map("checked_in_at")
  note        String?
  correctedBy String?                 @map("corrected_by") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@index([tenantId, date])
  @@map("teacher_attendance")
}

// ───────────── Leave (Phase 3, decision D5) ─────────────

model LeaveType {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String
  forStudents Boolean   @default(true) @map("for_students")
  forStaff    Boolean   @default(true) @map("for_staff")
  archivedAt  DateTime? @map("archived_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests LeaveRequest[]

  @@unique([tenantId, name])
  @@map("leave_types")
}

model LeaveRequest {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  applicantId  String      @map("applicant_id") @db.Uuid
  /// Set when the applicant is a student (routes to their Class Incharge).
  studentId    String?     @map("student_id") @db.Uuid
  typeId       String      @map("type_id") @db.Uuid
  fromDate     DateTime    @map("from_date") @db.Date
  toDate       DateTime    @map("to_date") @db.Date
  reason       String
  status       LeaveStatus @default(PENDING)
  decidedBy    String?     @map("decided_by") @db.Uuid
  decidedAt    DateTime?   @map("decided_at")
  decisionNote String?     @map("decision_note")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicant User      @relation("LeaveApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  student   Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      LeaveType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([applicantId])
  @@index([studentId])
  @@map("leave_requests")
}

// ───────────── Assessment (Phase 3, spec §7) ─────────────

model Assessment {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  academicYearId  String           @map("academic_year_id") @db.Uuid
  sectionId       String           @map("section_id") @db.Uuid
  subjectId       String           @map("subject_id") @db.Uuid
  gradingSchemeId String           @map("grading_scheme_id") @db.Uuid
  name            String
  maxMarks        Decimal          @map("max_marks") @db.Decimal(6, 2)
  heldOn          DateTime         @map("held_on") @db.Date
  status          AssessmentStatus @default(DRAFT)
  createdBy       String           @map("created_by") @db.Uuid
  submittedBy     String?          @map("submitted_by") @db.Uuid
  submittedAt     DateTime?        @map("submitted_at")
  publishedBy     String?          @map("published_by") @db.Uuid
  publishedAt     DateTime?        @map("published_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  section       Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject       Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradingScheme GradingScheme @relation(fields: [gradingSchemeId], references: [id], onDelete: Restrict)
  marks         Mark[]

  @@index([tenantId, sectionId])
  @@index([sectionId, subjectId])
  @@index([academicYearId])
  @@index([subjectId])
  @@index([gradingSchemeId])
  @@map("assessments")
}

model Mark {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  assessmentId String   @map("assessment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  score        Decimal? @db.Decimal(6, 2)
  absent       Boolean  @default(false)
  updatedBy    String?  @map("updated_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
  @@index([tenantId])
  @@map("marks")
}

/**
 * Teacher remarks; visible to students only once approved by the Class Incharge or School Admin (spec §7.4).
 */
model Remark {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  studentId   String       @map("student_id") @db.Uuid
  authorId    String       @map("author_id") @db.Uuid
  subjectName String?      @map("subject_name")
  text        String
  status      RemarkStatus @default(PENDING)
  moderatedBy String?      @map("moderated_by") @db.Uuid
  moderatedAt DateTime?    @map("moderated_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation("RemarkAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([studentId])
  @@index([authorId])
  @@map("remarks")
}

// ───────────── Timetable (Phase 3, decision D12) ─────────────
// Stored per section, never per student (spec §12.2). DB constraints make clashes impossible.

model TimetableSlot {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  /// 1 = Monday … 7 = Sunday
  dayOfWeek Int     @map("day_of_week")
  periodNo  Int     @map("period_no")
  startsAt  String  @map("starts_at")
  endsAt    String  @map("ends_at")
  isBreak   Boolean @default(false) @map("is_break")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries TimetableEntry[]

  @@unique([tenantId, dayOfWeek, periodNo])
  @@map("timetable_slots")
}

model TimetableEntry {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  sectionId String  @map("section_id") @db.Uuid
  slotId    String  @map("slot_id") @db.Uuid
  subjectId String  @map("subject_id") @db.Uuid
  teacherId String? @map("teacher_id") @db.Uuid
  room      String?

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  slot    TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  subject Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([sectionId, slotId])
  @@index([teacherId])
  @@index([slotId])
  @@index([subjectId])
  @@index([tenantId])
  @@map("timetable_entries")
}

// ───────────── In-app notifications (spec §1.3; channels beyond in-app deferred) ─────────────

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  title     String
  body      String
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

// ───────────── Announcements (Phase 4, spec §8.11) ─────────────

model Announcement {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  title     String
  body      String
  audience  AnnouncementAudience
  sectionId String?              @map("section_id") @db.Uuid
  pinned    Boolean              @default(false)
  createdBy String               @map("created_by") @db.Uuid
  createdAt DateTime             @default(now()) @map("created_at")
  expiresOn DateTime?            @map("expires_on") @db.Date
  deletedAt DateTime?            @map("deleted_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  author  User     @relation(fields: [createdBy], references: [id])

  @@index([tenantId, createdAt])
  @@map("announcements")
}
