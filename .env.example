# ---- Database ----
# App runtime role: RLS enforced (member of edusaas_app). Use the pooler URL in Supabase.
DATABASE_URL="postgresql://edusaas_app_login:app_password@localhost:5432/edusaas"
# Privileged runtime role: BYPASSRLS, but INSERT/SELECT only on audit_logs. Used only by auth/platform/audit/jobs.
SYSTEM_DATABASE_URL="postgresql://edusaas_system_login:system_password@localhost:5432/edusaas"
# Owner role: migrations only. Never used by the running app.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/edusaas"
# Passwords used by `npm run db:roles` to create the two login roles above.
DB_APP_PASSWORD="app_password"
DB_SYSTEM_PASSWORD="system_password"

# ---- App ----
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="EDUsaas"
SESSION_TTL_DAYS="60"
# Required in production (min 32 chars). Protects /api/internal/* (cron + jobs).
CRON_SECRET="dev-only-cron-secret-change-me-0000000000"

# ---- Storage (Phase 2) ----
STORAGE_DRIVER="local"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ---- Monitoring ----
SENTRY_DSN=""

# ── File storage (photos, archived report cards, audit archives) ──────────────
# Local development: files go to ./.storage (default when not on Vercel).
# Production / Vercel: an S3-compatible private bucket — Cloudflare R2 (spec §11.6), Supabase Storage, AWS S3…
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="edusaas"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"

# ── Error monitoring (optional) ───────────────────────────────────────────────
# SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<project>"
